{
  "name": "miautify",
  "version": "0.1.0",
  "description": "A music player that points at a folder and plays it.",
  "license": "MIT",
  "author": "André Leandro",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
