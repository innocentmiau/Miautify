    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "music-metadata": "^11.16.1"
  }
}
