{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Tests import .ts files directly, because Node runs them without a build step.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test"]
}
